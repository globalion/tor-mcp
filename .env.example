# Copy to .env and fill in.

# --- Postgres (docker-compose sets DATABASE_URL for the web container) ---
# DATABASE_URL=postgresql://admin:admin@db:5432/tor_mcp

# --- NextAuth ---
NEXTAUTH_SECRET=REPLACE_WITH_openssl_rand_-base64_32
NEXTAUTH_URL=https://tor.regiq.in
PUBLIC_BASE_URL=https://tor.regiq.in

# --- Google OAuth (only provider) ---
# Create at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://tor.regiq.in/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Tor control port ---
# Any strong string. Tor hashes it at boot; the web container uses the
# plaintext to send SIGNAL NEWNYM. Never exposed to the internet — the
# control port only listens on the internal docker network.
TOR_CONTROL_PASSWORD=REPLACE_WITH_openssl_rand_-hex_24

# --- Admins ---
# Comma-separated. Admins skip rate limits.
ADMIN_EMAILS=shreyas.pavuluri@gmail.com
